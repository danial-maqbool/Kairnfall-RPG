; Kairnfall Windows MMORPG client.
config_version=5

[application]
config/name="Kairnfall"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/description="A persistent, skill-driven fantasy world."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1024
window/size/min_height=720
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Kairnfall.Client"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.045,0.057,0.068,1)
