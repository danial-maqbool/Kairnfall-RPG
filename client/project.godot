; Kairnfall Windows MMORPG client.
; The dedicated server owns gameplay state.
config_version=5

[application]
config/name="Kairnfall"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/description="A persistent skill-driven medieval fantasy realm."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=1024
window/size/min_height=720
window/stretch/mode="canvas_items"
window/size/resizable=true

[dotnet]
project/assembly_name="Kairnfall.Client"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.071, 0.079, 1)

[audio]
driver/enable_input=false
