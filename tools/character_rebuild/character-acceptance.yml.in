name: Character sprite acceptance
on:
  push:
    branches: [main]
    paths:
      - 'tools/art/**'
      - 'tools/build_game_assets.py'
      - 'tools/build_wayfarer_pack.py'
      - 'tools/validate*assets.py'
      - 'tools/integrate_atelier.py'
      - 'tools/character_probe/**'
      - 'tools/run_character_native.py'
      - 'art/wayfarer/**'
      - 'client/Scripts/PixelAssets.cs'
      - 'client/Scripts/SpritePoseRules.cs'
      - 'client/Scripts/WorldView*.cs'
      - 'client/Scripts/GameRoot.cs'
      - 'client/Tests/*PresentationContract.*'
      - 'src/Kairnfall.Core/ActorPresentation.cs'
      - 'src/Kairnfall.Core/Models.cs'
      - 'src/Kairnfall.Core/RealmEngine.cs'
      - 'src/Kairnfall.Core/ReconnectRecovery.cs'
      - 'content_src/**'
      - 'src/release-candidate.trigger'
      - '.github/workflows/grounded-actor-acceptance.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: character-sprites-${{ github.ref }}
  cancel-in-progress: true
jobs:
  verify:
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            godot: linux
          - os: windows-latest
            godot: windows
    runs-on: ${{ matrix.os }}
    timeout-minutes: 55
    env:
      PYTHONUTF8: '1'
      PYTHONDONTWRITEBYTECODE: '1'
      DOTNET_CLI_TELEMETRY_OPTOUT: '1'
      DOTNET_NOLOGO: '1'
      LIBGL_ALWAYS_SOFTWARE: '1'
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'
      - name: Rebuild and verify the committed actor source
        run: |
          set -euo pipefail
          mkdir -p artifacts/character-acceptance/logs
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          git rev-parse HEAD > artifacts/character-acceptance/revision.txt
          python -m pip install Pillow==12.0.0
          python tools/build_content.py 2>&1 | tee artifacts/character-acceptance/logs/content.log
          dotnet build client/Kairnfall.Client.csproj -c Debug 2>&1 | tee artifacts/character-acceptance/logs/client-build.log
          dotnet run --project tools/character_probe -c Release -- content/catalog.json 2>&1 | tee artifacts/character-acceptance/logs/authority-and-clock.log
          python tools/build_game_assets.py 2>&1 | tee artifacts/character-acceptance/logs/assets.log
          python tools/complete_skill_icons.py
          python tools/validate_game_assets.py 2>&1 | tee artifacts/character-acceptance/logs/general-validation.log
          python tools/validate_character_assets.py 2>&1 | tee artifacts/character-acceptance/logs/character-validation.log
          python tools/build_wayfarer_pack.py 2>&1 | tee artifacts/character-acceptance/logs/committed-pack.log
          python tools/get_godot.py --os '${{ matrix.godot }}' 2>&1 | tee artifacts/character-acceptance/logs/godot.log
      - name: Execute native rendering and animation fixtures
        run: |
          set -euo pipefail
          python tools/run_character_native.py --output artifacts/character-acceptance
          git diff --check
          git diff --exit-code -- art/wayfarer tools/art client/Scripts src/Kairnfall.Core
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: character-sprites-${{ matrix.os }}-${{ github.sha }}
          path: |
            artifacts/character-acceptance/
            artifacts/test-results/character-assets.json
            artifacts/test-results/asset-structure.json
          retention-days: 14
          if-no-files-found: error
